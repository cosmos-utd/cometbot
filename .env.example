# Copy to .env for `docker compose up`. Never commit .env.

# Discord bot token and your Discord user id (bot owner can always run moderator commands)
DISCORD_TOKEN=
DISCORD_OWNER_ID=

# Shared secret for the REST API (X-API-Key header). Leave empty only for local testing.
API_KEY=

# Bedrock (Amazon Titan Text Express)
AWS_REGION=us-east-2
BEDROCK_MODEL_ID=amazon.titan-text-express-v1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

REMINDER_TZ=America/Chicago
